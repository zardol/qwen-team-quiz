# Порт сервера (Railway / Render задают PORT автоматически)
PORT=3000

# Логин и пароль для входа в панель администратора (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-strong-password

# Секретный ключ для подписи сессионного токена админа
ADMIN_SESSION_SECRET=change-this-secret-in-production

# Настройки Alibaba Cloud Model Studio / QwenCloud (регион ap-southeast-1)
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
